# Discord user ID for the taskbar presence widget
# Copy to .env.local and replace with your numeric Discord user ID.
VITE_DISCORD_USER_ID=

# Steam API key used only by the Vite server middleware.
# Keep this in .env.local (no VITE_ prefix), never in client code.
STEAM_API_KEY=

# Optional: defaults to Ras's profile ID when omitted.
STEAM_ID=76561198119046479
